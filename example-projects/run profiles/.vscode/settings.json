{
    "behave-vsc.xRay": true,
    "behave-vsc.env": {
        "var1": "ENV-var1",
        "var3": "ENV-var3",
    },
    "behave-vsc.args": [
        "-D",
        "foo=bar",
        "-D",
        "fizz=buzz",
    ],
    "behave-vsc.runProfiles": [
        // note - for multiroot, runProfiles will only be read from the workspace file 
        // (do not create conflicting profile names between projects)
        {
            "name": "prompt for tags",
            "promptForAdhocTags": true,
            "env": {
                "envVars": {
                    "profile": "prompt for tags",
                }
            },
            "args": {
                "argList": [
                    "--tags=@another_tag"
                ]
            },
        },
        {
            "name": "qu'oted\"tag and qu'oted\"env profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "qu'oted\"tag and qu'oted\"env profile",
                    "qu'oted\"env": "v'al\"ue"
                }
            },
            "args": {
                "argList": [
                    "--tags=@qu'oted\"tag"
                ]
            },
        },
        {
            "name": "inherit args and envs profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "inherit args and envs profile",
                }
            },
            "args": {
                "argList": [
                    "-D",
                    "d1=val1",
                    "-D",
                    "d2=val2"
                ]
            },
        },
        {
            "name": "do NOT inherit args and envs profile",
            "promptForAdhocTags": false,
            "env": {
                "inherit": false,
                "envVars": {
                    "profile": "do NOT inherit args and envs profile",
                    "var1": "do NOT inherit",
                }
            },
            "args": {
                "inherit": false,
                "argList": [
                    "-D",
                    "do=NOT inherit",
                ]
            },
        },
        {
            "name": "no args profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "no args profile",
                }
            },
            "args": {
                "inherit": false,
                "argList": []
            },
        },
        {
            "name": "stage2 profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "stage2 profile",
                    "BEHAVE_STAGE": "stage2"
                }
            },
        },
        {
            "name": "tag1 profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag1 profile",
                }
            },
            "args": {
                "argList": [
                    "--tags=tag1"
                ],
            }
        },
        {
            "name": "tag1 vars profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag1 vars profile",
                    "var1": "TAG1-var1",
                    "var2": "TAG1-var2"
                }
            },
            "args": {
                "argList": [
                    "--tags=tag1"
                ]
            }
        },
        {
            "name": "tag2 vars profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag2 vars profile",
                    "var1": "TAG2-var1",
                    "var2": "TAG2-var2"
                }
            },
            "args": {
                "argList": [
                    "--tags=@tag2"
                ],
            },
        },
        {
            "name": "tag1ortag2 vars profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag1ortag2 vars profile",
                    "var1": "TAG1_OR_2-var1",
                    "var2": "TAG1_OR_2-var2"
                }
            },
            "args": {
                "argList": [
                    "--tags=tag1,@tag2"
                ],
            },
        },
        {
            "name": "tag1andtag2 profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag1andtag2 profile",
                }
            },
            "args": {
                "argList": [
                    "--tags=tag1",
                    "--tags=tag2"
                ],
            },
        },
        {
            "name": "tag1ortag2andtag3 profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "tag1ortag2andtag3 profile",
                }
            },
            "args": {
                "argList": [
                    "--tags=tag1,tag2",
                    "--tags=tag3"
                ],
            },
        },
        {
            "name": "nottag1andnottag2 profile",
            "promptForAdhocTags": false,
            "env": {
                "envVars": {
                    "profile": "nottag1andnottag2 profile",
                }
            },
            "args": {
                "argList": [
                    "--tags=~tag1",
                    "--tags=-tag2"
                ],
            },
        }
    ],
    "mypy-type-checker.ignorePatterns": [
        ".*"
    ],
}